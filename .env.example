# Proxmox API Configuration
PROXMOX_API_URL=https://your-proxmox-server:8006/api2/json

# Authentication - choose one:
# Option 1: API Token (recommended - tokens do not expire)
PROXMOX_TOKEN_ID=root@pam!mcp
PROXMOX_TOKEN_SECRET=your-token-secret

# Option 2: Username/Password
# The username must include a realm. Password sessions use a ticket that
# expires after roughly two hours.
# PROXMOX_USERNAME=root@pam
# PROXMOX_PASSWORD=your-password

# Read-Only Mode (default: true for security)
# Set to 'false' to register write operations (use with caution).
# Accepts: true/1/yes/on/enabled/y/t and false/0/no/off/disabled/n/f
# Any unrecognized value falls back to the safe default and logs a warning,
# so a typo cannot silently enable write operations.
# PROXMOX_READ_ONLY=false

# TLS
# Proxmox ships a self-signed certificate, so a default install will fail
# verification. Prefer trusting the cluster CA over disabling verification:
# copy /etc/pve/pve-root-ca.pem from a node.
# PROXMOX_CA_FILE=/path/to/pve-root-ca.pem
#
# Skips certificate verification entirely (default: false). Not recommended -
# your API token is exposed to anyone who can intercept the connection.
# PROXMOX_TLS_INSECURE=true

# Timeouts
# Per-HTTP-request timeout. Accepts a duration ("45s", "2m") or bare seconds.
# PROXMOX_HTTP_TIMEOUT=30s
#
# Seconds to wait for an async task such as a backup or migration.
# PROXMOX_TASK_TIMEOUT=300
